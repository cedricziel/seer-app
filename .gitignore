# Xcode — project is regenerated by xcodegen, so we exclude contents and
# selectively re-include only files we want tracked. Using `**` rather
# than a trailing slash on the parent so re-includes can drill in.
# project.pbxproj is intentionally NOT re-included — xcodegen regenerates it.
*.xcodeproj/**
!*.xcodeproj/project.xcworkspace
!*.xcodeproj/project.xcworkspace/xcshareddata
!*.xcodeproj/project.xcworkspace/xcshareddata/**
*.xcworkspace/**
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata
!*.xcworkspace/xcshareddata/**
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint
*.xcscheme

# Build
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
# Note: We keep our own Packages/ directory tracked (contains local packages)
# and the xcodeproj's resolved file (re-included via xcshareddata/**) so
# Dependabot can track the main app's SPM dependency versions.
Package.resolved
!Packages/**/Package.resolved
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods (we don't use CocoaPods, but defensive)
Pods/
Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/README.md
fastlane/.env
fastlane/.env.local
fastlane/.env.local.*
fastlane/.env.*.local

# App Store Connect API keys / signing material — never commit
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
AuthKey_*.p8

# Bundler
.bundle/
vendor/bundle/

# Code Injection
iOSInjectionProject/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
*.xcconfig

# Archives
*.xcarchive

# Playground
timeline.xctimeline
playground.xcworkspace

# Generated files
*.generated.swift
App/SeerApp/SeerApp.entitlements

# Secrets (if any)
secrets/
credentials/
.claude/settings.local.json

# Isolated agent run worktrees — local-only, never committed.
.claude/worktrees/

# Scheduling lockfile written by the agent runtime — local-only.
.claude/scheduled_tasks.lock

# swift-snapshot-testing failure / diff artifacts (the .1.png references
# ARE committed; *.failure.png and *.diff.png are written on a mismatch
# and should stay local — CI uploads them as artifacts).
**/__Snapshots__/**/*.failure.png
**/__Snapshots__/**/*.diff.png

.playwright-mcp/
