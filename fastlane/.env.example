# Copy this file to fastlane/.env (gitignored) and fill in real values, OR
# inject the same variables via your secret manager of choice. CI provides
# them via GitHub Actions secrets — see .github/workflows/beta.yml.

# ---------------------------------------------------------------------------
# App Store Connect API key
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
# Role: Admin or App Manager.
# ---------------------------------------------------------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=

# Provide ONE of:
#   ASC_KEY_PATH    — absolute path to the AuthKey_XXXX.p8 file
#   ASC_KEY_CONTENT — full contents of the .p8 file (raw PEM or base64)
ASC_KEY_PATH=
ASC_KEY_CONTENT=

# ---------------------------------------------------------------------------
# match — code signing
# Use a SEPARATE PRIVATE git repository to store encrypted certificates.
# See https://docs.fastlane.tools/actions/match/ for the storage layout.
# ---------------------------------------------------------------------------
MATCH_GIT_URL=
MATCH_GIT_BRANCH=
MATCH_PASSWORD=

# Required only on CI (to unlock the runner's temporary keychain).
MATCH_KEYCHAIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# FASTLANE_APPLE_ID=
# FASTLANE_TEAM_ID=
# SIMULATOR=iPhone 17
