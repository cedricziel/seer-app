opt_out_usage

default_platform(:ios)

# Path constants
WORKSPACE       = nil
PROJECT         = "SeerApp.xcodeproj"
SCHEME          = "SeerApp"
APP_IDENTIFIER  = "com.cedricziel.seer"
OUTPUT_DIR      = "build"

# Build number = number of commits reachable from HEAD. Reproducible from git
# state alone — never committed back to project.yml.
def commit_count_build_number
  @commit_count_build_number ||= sh("git rev-list --count HEAD", log: false).strip
end

def archive_xcargs
  "CURRENT_PROJECT_VERSION=#{commit_count_build_number}"
end

before_all do |lane, options|
  Dotenv.load(".env") if File.exist?(".env")
  # Without setup_ci, codesign on macOS runners hangs forever waiting for
  # an interactive keychain unlock when signing SPM-derived frameworks.
  # setup_ci creates a temp keychain, imports certs, and bless the private
  # key for non-interactive use.
  setup_ci if is_ci
  ensure_xcode_project_generated
end

# ---------------------------------------------------------------------------
# Public lanes
# ---------------------------------------------------------------------------

desc "Run all unit tests on the iOS simulator"
lane :test do
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    devices: [ENV["SIMULATOR"] || "iPhone 17"],
    clean: false,
    output_directory: "fastlane/test_output",
    # Fail a test that stalls instead of holding the runner until the job
    # limit. 120s is far above the slowest legitimate test in this suite.
    xcargs: "-test-timeouts-enabled YES -default-test-execution-time-allowance 120"
  )
end

desc "Build the app for release without uploading (sanity check)"
lane :build do
  api_key = load_app_store_connect_api_key
  sync_code_signing(type: "appstore", readonly: is_ci, api_key: api_key)

  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR,
    output_name: "SeerApp.ipa",
    clean: true,
    include_symbols: true,
    include_bitcode: false,
    destination: "generic/platform=iOS",
    xcargs: archive_xcargs
  )
end

desc "Push a new beta build to TestFlight"
lane :beta do |options|
  api_key = load_app_store_connect_api_key
  ensure_git_status_clean unless options[:allow_dirty]

  # xcodebuild archive resolves dev profiles for some intermediate build
  # phases even when configuration:Release. Sync both so the keychain has
  # everything available; final signing still uses the appstore profile.
  sync_code_signing(type: "development", readonly: is_ci, api_key: api_key)
  sync_code_signing(type: "appstore",    readonly: is_ci, api_key: api_key)

  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR,
    output_name: "SeerApp.ipa",
    clean: true,
    include_symbols: true,
    include_bitcode: false,
    destination: "generic/platform=iOS",
    xcargs: archive_xcargs
  )

  upload_to_testflight(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    skip_waiting_for_build_processing: true,
    changelog: options[:changelog] || "Beta build #{Time.now.strftime('%Y-%m-%d %H:%M')}"
  )
  # dSYMs are bundled in the IPA via build_app's include_symbols:true and
  # App Store Connect extracts them automatically — no separate upload step.
end

desc "Submit an existing TestFlight build to App Store review without rebuilding"
lane :submit_to_app_store do |options|
  api_key = load_app_store_connect_api_key
  stage_release_notes!(options[:release_notes] || ENV["RELEASE_NOTES"])

  upload_to_app_store(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    skip_binary_upload: true,
    submit_for_review: options[:submit] != false,
    automatic_release: options[:auto_release] == true,
    force: true,
    precheck_include_in_app_purchases: false,
    skip_screenshots: true,
    skip_metadata: options[:metadata] == false,
    build_number: options[:build]
  )
end

desc "Upload App Store metadata (description, keywords, release notes, ...) without touching the binary"
lane :sync_metadata do |options|
  api_key = load_app_store_connect_api_key
  stage_release_notes!(options[:release_notes] || ENV["RELEASE_NOTES"])

  upload_to_app_store(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    skip_binary_upload: true,
    skip_screenshots: true,
    skip_metadata: false,
    submit_for_review: false,
    automatic_release: false,
    force: true,
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: false
  )
end

desc "Push a release build to App Store Connect (does not submit for review by default)"
lane :release do |options|
  submit_for_review = options[:submit] == true || ENV["SUBMIT_FOR_REVIEW"] == "true"
  api_key = load_app_store_connect_api_key
  ensure_git_status_clean unless options[:allow_dirty]
  stage_release_notes!(options[:release_notes] || ENV["RELEASE_NOTES"])

  sync_code_signing(type: "appstore", readonly: is_ci, api_key: api_key)

  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR,
    output_name: "SeerApp.ipa",
    clean: true,
    include_symbols: true,
    include_bitcode: false,
    destination: "generic/platform=iOS",
    xcargs: archive_xcargs
  )

  upload_to_app_store(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    submit_for_review: submit_for_review,
    automatic_release: false,
    force: true,
    precheck_include_in_app_purchases: false,
    skip_screenshots: true,
    skip_metadata: options[:metadata] == false
  )
end

# Workaround for an iOS 26.4.1-era fastlane bug: `xcrun simctl list devices`
# emits section headers like `-- iOS 26.4 --` even when the runtime is
# actually 26.4.1. fastlane's DeviceManager parses that string for the OS
# version and ends up building destinations like
# `OS=26.4`, which xcodebuild rejects against a 26.4.1 simulator. Patch
# the parsed os_version with the full runtime version from
# `xcrun simctl list runtimes -j` so the destination string xcodebuild
# sees actually matches what's installed.
require 'fastlane_core/device_manager'
require 'json'
::FastlaneCore::DeviceManager.singleton_class.class_eval do
  unless method_defined?(:_orig_simulators)
    alias_method :_orig_simulators, :simulators

    def simulators(requested_os_type = "")
      sims = _orig_simulators(requested_os_type)
      runtimes = JSON.parse(`xcrun simctl list -j runtimes`)['runtimes']
        .select { |r| r['isAvailable'] != false }
      full_versions = runtimes.each_with_object({}) do |r, h|
        short = r['version'].split('.').first(2).join('.')
        h[short] = r['version']
      end
      sims.each do |sim|
        full = full_versions[sim.os_version]
        next unless full && full != sim.os_version
        sim.os_version = full
        sim.ios_version = full
      end
      sims
    end
  end
end

desc "Generate App Store screenshots via the SeerAppUITests UI test (uses the public Jellyfin demo)"
lane :screenshots do
  capture_ios_screenshots
end

desc "Sync signing certificates and provisioning profiles via match"
lane :sync_signing do |options|
  type = options[:type] || "development"
  api_key = load_app_store_connect_api_key
  match(type: type, readonly: options[:readonly] != false, api_key: api_key)
end

desc "Bootstrap signing — creates new certs/profiles. Run once per environment."
lane :bootstrap_signing do
  api_key = load_app_store_connect_api_key
  match(type: "development", readonly: false, api_key: api_key)
  match(type: "appstore",    readonly: false, api_key: api_key)
end

desc "Download dSYMs from App Store Connect (e.g. after a bitcode rebuild on Apple's side)"
lane :refresh_dsyms do |options|
  api_key = load_app_store_connect_api_key
  download_dsyms(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    version: options[:version] || "latest",
    build_number: options[:build]
  )
end

desc "Print the build number that would be used (commit count from HEAD)"
lane :show_build_number do
  UI.message("Build number: #{commit_count_build_number}")
end

# ---------------------------------------------------------------------------
# Private helpers
# ---------------------------------------------------------------------------

desc "Regenerate the Xcode project from project.yml when missing"
private_lane :ensure_xcode_project_generated do
  unless File.exist?("../#{PROJECT}/project.pbxproj")
    UI.message("Generating Xcode project via xcodegen...")
    sh "cd .. && xcodegen generate"
  end
end

# Stages release notes into fastlane/metadata/<locale>/release_notes.txt so
# upload_to_app_store picks them up. No-op when the input is nil/empty so a
# previously committed release_notes.txt remains the source of truth.
def stage_release_notes!(notes, locale: "en-US")
  return if notes.nil? || notes.to_s.strip.empty?

  dir = File.expand_path("metadata/#{locale}", __dir__)
  FileUtils.mkdir_p(dir)
  path = File.join(dir, "release_notes.txt")
  File.write(path, notes.to_s.strip + "\n")
  UI.message("Staged release notes (#{notes.to_s.strip.bytesize} bytes) at #{path}")
end

# Loads an App Store Connect API key from one of:
#   - ASC_KEY_PATH        : filesystem path to the .p8 file
#   - ASC_KEY_CONTENT     : raw or base64-encoded contents of the .p8 file
#
# Required env vars: ASC_KEY_ID, ASC_ISSUER_ID
def load_app_store_connect_api_key
  return @asc_api_key if @asc_api_key

  key_id     = ENV["ASC_KEY_ID"]
  issuer_id  = ENV["ASC_ISSUER_ID"]
  key_path   = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"]

  if key_id.nil? || issuer_id.nil? || (key_path.nil? && key_content.nil?)
    UI.user_error!(<<~MSG)
      Missing App Store Connect API key configuration. Set:
        ASC_KEY_ID         (e.g. ABC123XYZ9)
        ASC_ISSUER_ID      (UUID from appstoreconnect.apple.com -> Users and Access -> Keys)
        ASC_KEY_PATH       (path to .p8 file)  OR  ASC_KEY_CONTENT (raw or base64)

      Locally: copy fastlane/.env.example to fastlane/.env and fill in.
      In CI:   configure these as GitHub Actions secrets (see docs/fastlane.md).
    MSG
  end

  @asc_api_key = app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    key_content: key_content,
    is_key_content_base64: !key_content.nil? && key_content.match?(/\A[A-Za-z0-9+\/=\s]+\z/) && !key_content.include?("BEGIN PRIVATE KEY"),
    in_house: false
  )
end

error do |lane, exception|
  UI.error("Lane #{lane} failed: #{exception.message}")
end
