// Secrets configuration template.
// Copy this file to Secrets.xcconfig and fill in the values.
// Secrets.xcconfig is ignored by git (*.xcconfig in .gitignore).
//
// Both values are read from Info.plist by TelemetryService at app launch
// and gated by user opt-in via DiagnosticsConsent — nothing leaves the
// device unless the user enables crash reports / performance metrics
// in PrivacySettingsView.
//
// Leave these unset to disable telemetry locally; TelemetryService
// rejects empty values and values still containing "$(" so the build
// will not break.

// OTLP/HTTP base endpoint. TelemetryService appends /v1/{logs,traces,metrics}.
// xcconfig treats // as a comment marker, so URLs must be escaped as /$()/.
// Example: OTLP_ENDPOINT = https:/$()/otel.example.com
OTLP_ENDPOINT =

// OTLP authentication header in "HeaderName: HeaderValue" form.
// Example: OTLP_AUTH_HEADER = Authorization: Bearer your-token-here
OTLP_AUTH_HEADER =
